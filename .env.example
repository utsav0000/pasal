# ---------------------------------------------------------------
# PASAL configuration. Copy to .env and fill in what you need.
# Everything is optional for local development.
# ---------------------------------------------------------------

NODE_ENV=production
PORT=3000
# Public URL used in emails, OAuth redirects, payment callbacks, sitemap and canonical URLs
PUBLIC_URL=https://pasal.example.com

# Storage
DATABASE_PATH=./data/pasal.db
UPLOAD_DIR=./public/uploads

# Sessions & security
SESSION_DAYS=30
COOKIE_SECURE=true            # true behind HTTPS
# Dev mailbox (/dev/mailbox) and the built-in test payment gateway. Never enable in production.
ENABLE_DEV_TOOLS=false

# Platform fee on online payments, in basis points (100 = 1%). Can also be changed in Admin → Settings.
PLATFORM_FEE_BPS=0

# ---------- Email (verification, password reset, notifications) ----------
# outbox = store in DB only (dev); resend = send via https://resend.com
EMAIL_PROVIDER=resend
EMAIL_FROM="PASAL <no-reply@pasal.example.com>"
RESEND_API_KEY=

# ---------- SMS (phone OTP for +91 / +977) ----------
# outbox = store in DB only (dev); twilio = send via Twilio
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Google sign-in (OAuth 2.0) ----------
# Authorised redirect URI: ${PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Payments: India (Razorpay) ----------
# Dashboard → Settings → API keys. Webhook URL: ${PUBLIC_URL}/api/v1/payments/webhook/razorpay
# Subscribe to: payment.captured, payment.failed, order.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Payments: Nepal (eSewa ePay v2) ----------
# Test endpoints are used by default; switch to the production URLs when going live.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Secret used to sign the built-in test gateway (only used when test mode is on)
SANDBOX_PAYMENT_SECRET=change-me-to-a-long-random-string

# ---------- First boot ----------
# On an empty database PASAL creates countries, locations and categories automatically.
# Set these to also create the first super admin (only if the email doesn't exist yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=PASAL Admin
