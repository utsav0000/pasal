{
  "name": "pasal",
  "version": "1.0.0",
  "private": true,
  "description": "PASAL \u2014 Everything Finds a Buyer. A buy & sell marketplace for India and Nepal.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.mjs",
    "build": "node scripts/build-web.mjs",
    "brand": "python3 scripts/wordmark.py public/fonts/DMSans-var.ttf scripts/wordmark.json && node scripts/build-brand.mjs",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.mjs",
    "setup": "npm run build && npm run seed",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/api/*.test.js\"",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
